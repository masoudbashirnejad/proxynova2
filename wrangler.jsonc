{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proxynova2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a6698e57-c63c-4a53-a17c-4f187003aa86","database_name": "proxydb" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "13247b01ef35416d879716ff7bebf1be" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
